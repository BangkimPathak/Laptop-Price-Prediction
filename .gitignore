# =============================================================================
# GitIgnore Configuration for Laptop Price Prediction Project
# =============================================================================

# 1. Datasets & CSV Files
*.csv
laptop_prices.csv
data/
datasets/

# 2. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# 3. Jupyter Notebook Checkpoints & Cache
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# 4. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 5. IDE & Editor Specific Files
.vscode/
.idea/
*.swp
*.swo

# 6. Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# 7. Temporary / Log Files
*.log
scratch/
